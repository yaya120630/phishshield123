{
  "manifest_version": 3,
  "name": "PhishShield",
  "version": "1.0.0",
  "description": "AI-powered phishing URL detection with browser extension protection.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "webNavigation",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://phishshield-904ab.web.app/*",
    "https://phishshield-904ab.firebaseapp.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "index.html",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}