# Copy this file to .env and fill in your own keys. Never commit .env.

# https://www.virustotal.com/gui/my-apikey (free tier: 4 requests/min, 500/day)
VT_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

PHISHSHIELD_HOST=127.0.0.1
PHISHSHIELD_PORT=8000

# Optional — set a random string here AND in public/js/config.js
# (API_KEY) to require a shared secret on every /api/detect request.
# Leave blank to keep the endpoint open (fine for local-only use).
PHISHSHIELD_API_KEY=

# Comma-separated list of extra origins allowed by CORS, on top of the
# built-in Firebase Hosting origins. Leave blank unless you add a custom
# domain for the web dashboard.
# e.g. CORS_ALLOW_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOW_ORIGINS=
